# Server Configuration
PORT=4000
FRONTEND_URL=http://localhost:3000

# Auth Token Signing Secret (ganti dengan secret acak milikmu sendiri)
AUTH_SECRET="change-me-to-a-strong-random-secret"

# PostgreSQL Connection String
# Sesuaikan username, password, host, port, dan nama database PostgreSQL kamu
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/garasi_u?schema=public"
