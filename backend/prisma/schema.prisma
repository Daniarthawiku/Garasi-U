generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VehicleType {
  CAR
  MOTORCYCLE
}

enum VehicleServiceStatus {
  NOT_SYNC
  HEALTHY
  SERVICE_SOON
  NEED_MAINTENANCE
}

enum ServiceCategory {
  ROUTINE_MAINTENANCE
  UNSCHEDULED_REPAIR
}

enum ServiceLogStatus {
  VERIFIED
  COMPLETED
}

model User {
  id             String    @id @default(uuid()) @db.Uuid
  name           String    @db.VarChar(80)
  email          String    @unique @db.VarChar(120)
  primaryVehicle String?   @db.VarChar(120)
  passwordSalt   String    @db.VarChar(64)
  passwordHash   String    @db.VarChar(255)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  vehicles Vehicle[]

  @@map("users")
}

model Vehicle {
  id              String               @id @default(uuid()) @db.Uuid
  userId          String?              @db.Uuid
  brand           String               @db.VarChar(80)
  model           String               @db.VarChar(100)
  nickname        String?              @db.VarChar(80)
  type            VehicleType          @default(CAR)
  year            Int?                 @db.SmallInt
  plate           String?              @unique @db.VarChar(20)
  tankCapacity    Float?
  initialOdometer Int                  @default(0)
  currentOdometer Int                  @default(0)
  serviceStatus   VehicleServiceStatus @default(NOT_SYNC)
  isActive        Boolean              @default(true)
  lastServiceDate DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  user        User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  parts       VehiclePart[]
  serviceLogs ServiceLog[]
  fuelLogs    FuelLog[]

  @@index([userId])
  @@map("vehicles")
}

model VehiclePart {
  id              String   @id @default(uuid()) @db.Uuid
  vehicleId       String   @db.Uuid
  name            String   @db.VarChar(120)
  intervalKm      Int      @default(5000)
  lastServiceOdo  Int
  lastServiceDate DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  vehicle     Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  serviceLogs ServiceLog[]

  @@unique([vehicleId, name])
  @@index([vehicleId])
  @@map("vehicle_parts")
}

model ServiceLog {
  id                String           @id @default(uuid()) @db.Uuid
  vehicleId         String           @db.Uuid
  vehiclePartId     String?          @db.Uuid
  serviceDate       DateTime
  odometerAtService Int
  category          ServiceCategory  @default(ROUTINE_MAINTENANCE)
  status            ServiceLogStatus @default(VERIFIED)
  part              String           @db.VarChar(150)
  workshop          String           @db.VarChar(120)
  cost              Decimal          @db.Decimal(12, 2)
  isWarrantyClaim   Boolean          @default(false)
  notes             String?          @db.Text
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  vehicle     Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  vehiclePart VehiclePart? @relation(fields: [vehiclePartId], references: [id], onDelete: SetNull)

  @@index([vehicleId, serviceDate(sort: Desc)])
  @@map("service_logs")
}

model FuelLog {
  id               Int      @id @default(autoincrement())
  vehicleId        String   @db.Uuid
  fuelType         String   @db.VarChar(60)
  liters           Float
  totalCost        Decimal  @db.Decimal(12, 2)
  odometerAtRefuel Int
  isFullTank       Boolean  @default(true)
  fuelEfficiency   Float?
  refuelDate       DateTime @db.Date
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, refuelDate(sort: Desc)])
  @@map("fuel_logs")
}
